<Window x:Class="MizanPro.Windows.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان برو — تسجيل الدخول"
        Width="980" Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}"
        UseLayoutRounding="True">

    <Grid MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <Grid.ColumnDefinitions>
            <!-- في الاتجاه RTL: العمود 0 يظهر يمين الشاشة -->
            <ColumnDefinition Width="600*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ اللوح الأيمن: نموذج الدخول / التفعيل (600px) ═══════════ -->
        <Grid Grid.Column="0" Background="White">

            <!-- زر إغلاق النافذة (أعلى يسار) -->
            <Button Content="✕" Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,12" FontSize="14" Click="Close_Click" />

            <!-- ════ وضع A: تسجيل الدخول ════ -->
            <StackPanel x:Name="LoginPanel" Margin="64,48" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="LoginTranslate" X="0" />
                </StackPanel.RenderTransform>

                <TextBlock Text="تسجيل الدخول" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" />

                <TextBlock Text="أدخل بيانات حسابك للمتابعة" FontSize="13"
                           Foreground="{StaticResource TextLightBrush}" Margin="0,8,0,32" />

                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBoxStyle}"
                         Tag="مثال: admin" KeyDown="UsernameBox_KeyDown" />

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabelStyle}" Margin="2,18,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- مربع كلمة المرور + مربع نص للإظهار (يتبادلان الظهور) -->
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                                 Grid.Column="0" KeyDown="PasswordBox_KeyDown" />
                    <TextBox x:Name="PasswordRevealBox" Style="{StaticResource ModernTextBoxStyle}"
                             Grid.Column="0" Visibility="Collapsed" IsReadOnly="True"
                             Foreground="{StaticResource TextDarkBrush}" />

                    <Button x:Name="RevealButton" Grid.Column="1" Content="●"
                            Style="{StaticResource GhostButtonStyle}" FontSize="15"
                            Margin="6,0,6,0" Width="34" Height="42"
                            ToolTip="إظهار / إخفاء كلمة المرور"
                            Click="RevealPassword_Click" />
                </Grid>

                <CheckBox x:Name="RememberCheck" Content="تذكّر جهازي"
                          Style="{StaticResource RoundCheckBoxStyle}" Margin="2,16,0,0" />

                <!-- رسالة الخطأ -->
                <Border x:Name="ErrorBorder" Background="#FEF2F2"
                        BorderBrush="#FCA5A5" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,18,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </Border>

                <!-- زر الدخول / شريط تحميل بديل عنه -->
                <Button x:Name="SignInButton" Content="دخول" Height="48"
                        Style="{StaticResource GoldButtonStyle}" Margin="0,20,0,0"
                        Click="SignIn_Click" />
                <ProgressBar x:Name="SignInProgress" Height="3" Margin="0,34,0,0"
                             Style="{StaticResource SlimProgressBarStyle}"
                             IsIndeterminate="True" Visibility="Collapsed" />

                <!-- فاصل "أو" -->
                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource LightBorderBrush}" Height="1"
                            Grid.Column="0" VerticalAlignment="Center" />
                    <TextBlock Text="أو" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                               Grid.Column="1" Margin="14,0" />
                    <Border Background="{StaticResource LightBorderBrush}" Height="1"
                            Grid.Column="2" VerticalAlignment="Center" />
                </Grid>

                <!-- حالة التجربة (تظهر فقط في وضع TRIAL) -->
                <StackPanel x:Name="TrialPanel" Margin="0,22,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TrialText" Text="⏰ X أيام متبقية من فترة التجربة"
                               FontSize="13" Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="تفعيل المنتج" Style="{StaticResource GoldOutlineButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="180"
                            Click="ShowActivation_Click" />
                </StackPanel>

                <!-- حالة النسخة المفعّلة (PRO) -->
                <TextBlock x:Name="ProText" Text="✓ النسخة مفعّلة — ميزان Pro"
                           FontSize="13" Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" Margin="0,22,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- ════ وضع B: تفعيل المنتج ════ -->
            <StackPanel x:Name="ActivationPanelView" Margin="64,48" Visibility="Collapsed">

                <TextBlock Text="تفعيل ميزان Pro" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" />

                <TextBlock Text="أدخل مفتاح الترخيص المكوّن من 20 حرفاً" FontSize="13"
                           Foreground="{StaticResource TextLightBrush}" Margin="0,8,0,28" />

                <!-- حقل المفتاح: خط ثابت العرض (محاكاة التباعد الواسع بين المحارف) -->
                <TextBox x:Name="KeyBox" Style="{StaticResource ModernTextBoxStyle}"
                         FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}"
                         FontSize="20" TextAlignment="Center" MaxLength="24"
                         Tag="XXXXX-XXXXX-XXXXX-XXXXX"
                         TextChanged="KeyBox_TextChanged" KeyDown="KeyBox_KeyDown" />

                <TextBlock Text="المفتاح يُدخل بصيغة: XXXXX-XXXXX-XXXXX-XXXXX"
                           FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                           Margin="2,8,0,0" HorizontalAlignment="Center"
                           FlowDirection="LeftToRight" />

                <!-- رسالة خطأ / نجاح -->
                <Border x:Name="ActivationMessageBorder" CornerRadius="8" Padding="12"
                        Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ActivationMessageText" Text="" FontSize="13" TextWrapping="Wrap" />
                </Border>

                <!-- زر التفعيل / شريط تحميل -->
                <Button x:Name="ActivateButton" Content="تحقق وتفعيل" Height="48"
                        Style="{StaticResource GoldButtonStyle}" Margin="0,22,0,0"
                        Click="Activate_Click" />
                <ProgressBar x:Name="ActivateProgress" Height="3" Margin="0,36,0,0"
                             Style="{StaticResource SlimProgressBarStyle}"
                             IsIndeterminate="True" Visibility="Collapsed" />

                <Button Content="← العودة لتسجيل الدخول"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,26,0,0"
                        Click="BackToLogin_Click" />
            </StackPanel>
        </Grid>

        <!-- ═══════════ اللوح الأيسر: التعريف بالمنتج (380px داكن) ═══════════ -->
        <Border Grid.Column="1" Background="{StaticResource DarkBgBrush}">
            <Grid Margin="40,44,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- الشعار -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="#16233A">
                        <TextBlock Text="⚖" FontSize="22" Foreground="{StaticResource GoldBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ميزان" FontSize="22" FontWeight="Bold" Foreground="White"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- الرسالة التسويقية -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="أدِر أعمالك بثقة" FontSize="22" FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="منصة محاسبية متكاملة تدعم الفاتورة الإلكترونية ونظام ZATCA"
                               FontSize="13" Foreground="{StaticResource TextFaintBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,28" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource GoldBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="فاتورة إلكترونية متوافقة مع هيئة الزكاة" FontSize="13"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource GoldBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="تقارير مالية لحظية بالريال السعودي" FontSize="13"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource GoldBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="نسخ احتياطي آمن ومشفر" FontSize="13"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="v3.0 · الإصدار السعودي" FontSize="10"
                           Foreground="#3D4F61" />
            </Grid>
        </Border>
    </Grid>

</Window>
