<Window x:Class="MizanPro.Windows.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عميل جديد"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <StackPanel Margin="28,24">

        <TextBlock Text="عميل جديد" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="أضف بيانات العميل الأساسية" Style="{StaticResource PageSubtitleStyle}"
                   Margin="0,6,0,18" />

        <Border Style="{StaticResource CardBorderStyle}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="الاسم (مطلوب)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="NameInput" Style="{StaticResource ModernTextBoxStyle}"
                         Tag="مثال: شركة الرياض للتجارة" />

                <TextBlock Text="الجوال (مطلوب)" Style="{StaticResource FieldLabelStyle}" Margin="2,16,0,6" />
                <TextBox x:Name="PhoneInput" Style="{StaticResource ModernTextBoxStyle}"
                         Tag="05XXXXXXXX" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,16,6,0">
                        <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="EmailInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="name@example.com" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,16,6,0">
                        <TextBlock Text="المدينة" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="CityInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="الرياض" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="العنوان" Style="{StaticResource FieldLabelStyle}" Margin="2,16,0,6" />
                <TextBox x:Name="AddressInput" Style="{StaticResource ModernTextBoxStyle}"
                         Tag="الحي، الشارع" />

                <TextBlock Text="الرقم الضريبي (15 رقماً إن وُجد)" Style="{StaticResource FieldLabelStyle}"
                           Margin="2,16,0,6" />
                <TextBox x:Name="TaxNumberInput" Style="{StaticResource ModernTextBoxStyle}"
                         Tag="3XXXXXXXXXXXXXX" MaxLength="15" />
            </StackPanel>
        </Border>

        <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FCA5A5"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,4">
            <Button Content="حفظ العميل" Style="{StaticResource GoldButtonStyle}" MinWidth="150"
                    Click="Save_Click" />
            <Button Content="إلغاء" Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                    Margin="12,0,0,0" Click="Cancel_Click" />
        </StackPanel>

    </StackPanel>

</Window>
