<Window x:Class="MizanPro.Windows.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منتج جديد"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}">

    <StackPanel Margin="28,24">

        <TextBlock Text="منتج جديد" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="أضف منتجاً جديداً إلى الكتالوج" Style="{StaticResource PageSubtitleStyle}"
                   Margin="0,6,0,18" />

        <Border Style="{StaticResource CardBorderStyle}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="اسم المنتج (مطلوب)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="NameInput" Style="{StaticResource ModernTextBoxStyle}"
                         Tag="مثال: كمبيوتر مكتبي HP" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,16,6,0">
                        <TextBlock Text="الرقم التعريفي SKU (مطلوب)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="SkuInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="LAP-002" FlowDirection="LeftToRight"
                                 FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,16,6,0">
                        <TextBlock Text="الفئة" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="CategoryInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="أجهزة" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,16,6,0">
                        <TextBlock Text="سعر البيع (ر.س)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PriceInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="2799" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,16,6,0">
                        <TextBlock Text="سعر التكلفة (ر.س)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="CostInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="2400" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,16,6,0">
                        <TextBlock Text="الكمية الابتدائية" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="StockInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="10" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,16,6,0">
                        <TextBlock Text="وحدة القياس" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="UnitInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="قطعة" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FCA5A5"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,4">
            <Button Content="حفظ المنتج" Style="{StaticResource GoldButtonStyle}" MinWidth="150"
                    Click="Save_Click" />
            <Button Content="إلغاء" Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                    Margin="12,0,0,0" Click="Cancel_Click" />
        </StackPanel>

    </StackPanel>

</Window>
