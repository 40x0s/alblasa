<Window x:Class="MizanPro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان برو — نظام المحاسبة السعودي"
        Width="1200" Height="740" MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ الشريط الجانبي (الجهة اليمنى بسبب RTL) ═══════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>

                <!-- الشعار -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42"
                                CornerRadius="21" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="⚖" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ميزان برو" Foreground="White"
                                       FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="نظام محاسبة سعودي" Foreground="#7FAE98" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#204635" Height="1" Margin="0,18,0,0" />
                </StackPanel>

                <!-- بطاقة المستخدم الحالي -->
                <Border DockPanel.Dock="Bottom" Margin="14" Padding="12"
                        CornerRadius="10" Background="#143024">
                    <StackPanel>
                        <TextBlock x:Name="UserNameText" Text="—"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="UserRoleText" Text="—"
                                   Foreground="#7FAE98" FontSize="11" Margin="0,3,0,0" />
                        <Button Content="تسجيل الخروج"
                                Style="{StaticResource GhostDangerButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                Click="Logout_Click" />
                    </StackPanel>
                </Border>

                <!-- أزرار التنقل — Tag يحدد اسم القسم -->
                <StackPanel Margin="14,16,14,14" VerticalAlignment="Top">
                    <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}"
                            Content="⌂   لوحة المعلومات" Tag="Dashboard" Click="Nav_Click" />
                    <Button x:Name="NavInvoices" Style="{StaticResource NavButtonStyle}"
                            Content="▤   الفواتير" Tag="Invoices" Click="Nav_Click" />
                    <Button x:Name="NavCustomers" Style="{StaticResource NavButtonStyle}"
                            Content="☰   العملاء" Tag="Customers" Click="Nav_Click" />
                    <Button x:Name="NavProducts" Style="{StaticResource NavButtonStyle}"
                            Content="⊞   المنتجات" Tag="Products" Click="Nav_Click" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════ منطقة المحتوى ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- الشريط العلوي -->
            <Border Background="White"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ViewTitle" Text="لوحة المعلومات"
                                   FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="ViewSubtitle" Text=""
                                   Margin="12,5,0,0" FontSize="12.5"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="DateText" Text=""
                                   FontSize="12.5" VerticalAlignment="Center" Margin="0,0,18,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChipUserName" Text="—"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="ChipUserRole" Text=""
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="12" Margin="8,1,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- المحتوى (لوحة واحدة ظاهرة في كل مرة حسب التنقل) -->
            <ScrollViewer Grid.Row="1" Padding="26,20,26,24"
                          VerticalScrollBarVisibility="Auto">

                <Grid>

                    <!-- ════ لوحة المعلومات ════ -->
                    <StackPanel x:Name="DashboardPanel" Visibility="Collapsed">

                        <!-- بطاقات الإحصاءات -->
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="5" Padding="16">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="{StaticResource PrimaryLightBrush}"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="▤" Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="17" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="MonthInvoicesValue" Text="0"
                                               FontSize="24" FontWeight="Bold" Margin="0,10,0,0"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="فواتير هذا الشهر" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="5" Padding="16">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="{StaticResource PrimaryLightBrush}"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="∑" Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="17" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="MonthSalesValue" Text="0"
                                               FontSize="24" FontWeight="Bold" Margin="0,10,0,0"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="مبيعات هذا الشهر (ر.س)" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="5" Padding="16">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="{StaticResource PrimaryLightBrush}"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="☰" Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="17" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ActiveCustomersValue" Text="0"
                                               FontSize="24" FontWeight="Bold" Margin="0,10,0,0"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="عملاء نشطون" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="5" Padding="16">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="#FDF0E3"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="▼" Foreground="{StaticResource WarningBrush}"
                                                   FontSize="17" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="LowStockValue" Text="0"
                                               FontSize="24" FontWeight="Bold" Margin="0,10,0,0"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="أصناف منخفضة المخزون" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- الفواتير المتأخرة + أصناف على وشك النفاد -->
                        <Grid Margin="5,15,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,5,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الفواتير المتأخرة السداد"
                                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                        <Border Background="#FBEAE8" CornerRadius="8"
                                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="OverdueCountText" Text="0"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <ListView x:Name="OverdueList" Margin="0,12,0,0"
                                              BorderThickness="0" Background="Transparent"
                                              MinHeight="120">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="رقم الفاتورة"
                                                                DisplayMemberBinding="{Binding InvoiceNumber}"
                                                                Width="130" />
                                                <GridViewColumn Header="العميل"
                                                                DisplayMemberBinding="{Binding Customer.Name}"
                                                                Width="150" />
                                                <GridViewColumn Header="الاستحقاق"
                                                                DisplayMemberBinding="{Binding DueDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                                                Width="95" />
                                                <GridViewColumn Header="المبلغ (ر.س)"
                                                                DisplayMemberBinding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                                Width="100" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1" Margin="5,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="أصناف على وشك النفاد"
                                                   Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                        <Border Background="#FDF0E3" CornerRadius="8"
                                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LowStockCountText" Text="0"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <ListView x:Name="LowStockList" Margin="0,12,0,0"
                                              BorderThickness="0" Background="Transparent"
                                              MinHeight="120">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="المنتج"
                                                                DisplayMemberBinding="{Binding Name}"
                                                                Width="190" />
                                                <GridViewColumn Header="SKU"
                                                                DisplayMemberBinding="{Binding SKU}"
                                                                Width="90" />
                                                <GridViewColumn Header="المتوفر"
                                                                DisplayMemberBinding="{Binding Stock}"
                                                                Width="70" />
                                                <GridViewColumn Header="التصنيف"
                                                                DisplayMemberBinding="{Binding Category}"
                                                                Width="90" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ════ الفواتير ════ -->
                    <Border x:Name="InvoicesPanel"
                            Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="جميع الفواتير" Style="{StaticResource CardTitleStyle}" />
                            <ListView x:Name="InvoicesList" Margin="0,12,0,0"
                                      BorderThickness="0" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="رقم الفاتورة"
                                                        DisplayMemberBinding="{Binding InvoiceNumber}"
                                                        Width="130" />
                                        <GridViewColumn Header="النوع"
                                                        DisplayMemberBinding="{Binding Type, Converter={StaticResource InvoiceTypeText}}"
                                                        Width="80" />
                                        <GridViewColumn Header="العميل"
                                                        DisplayMemberBinding="{Binding Customer.Name}"
                                                        Width="170" />
                                        <GridViewColumn Header="تاريخ الإصدار"
                                                        DisplayMemberBinding="{Binding IssueDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                                        Width="110" />
                                        <GridViewColumn Header="الاستحقاق"
                                                        DisplayMemberBinding="{Binding DueDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                                        Width="100" />
                                        <GridViewColumn Header="الإجمالي (ر.س)"
                                                        DisplayMemberBinding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                        Width="110" />
                                        <GridViewColumn Header="الحالة"
                                                        DisplayMemberBinding="{Binding Status, Converter={StaticResource InvoiceStatusText}}"
                                                        Width="90" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- ════ العملاء ════ -->
                    <Border x:Name="CustomersPanel"
                            Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="جميع العملاء" Style="{StaticResource CardTitleStyle}" />
                            <ListView x:Name="CustomersList" Margin="0,12,0,0"
                                      BorderThickness="0" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="الاسم"
                                                        DisplayMemberBinding="{Binding Name}"
                                                        Width="210" />
                                        <GridViewColumn Header="الجوال"
                                                        DisplayMemberBinding="{Binding Phone}"
                                                        Width="110" />
                                        <GridViewColumn Header="المدينة"
                                                        DisplayMemberBinding="{Binding City}"
                                                        Width="110" />
                                        <GridViewColumn Header="الرقم الضريبي"
                                                        DisplayMemberBinding="{Binding TaxNumber}"
                                                        Width="130" />
                                        <GridViewColumn Header="الرصيد (ر.س)"
                                                        DisplayMemberBinding="{Binding Balance, StringFormat='{}{0:N2}'}"
                                                        Width="110" />
                                        <GridViewColumn Header="الحالة"
                                                        DisplayMemberBinding="{Binding IsActive, Converter={StaticResource BooleanStateText}}"
                                                        Width="90" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- ════ المنتجات ════ -->
                    <Border x:Name="ProductsPanel"
                            Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="جميع المنتجات" Style="{StaticResource CardTitleStyle}" />
                            <ListView x:Name="ProductsList" Margin="0,12,0,0"
                                      BorderThickness="0" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="المنتج"
                                                        DisplayMemberBinding="{Binding Name}"
                                                        Width="250" />
                                        <GridViewColumn Header="SKU"
                                                        DisplayMemberBinding="{Binding SKU}"
                                                        Width="90" />
                                        <GridViewColumn Header="التصنيف"
                                                        DisplayMemberBinding="{Binding Category}"
                                                        Width="100" />
                                        <GridViewColumn Header="سعر البيع (ر.س)"
                                                        DisplayMemberBinding="{Binding Price, StringFormat='{}{0:N2}'}"
                                                        Width="110" />
                                        <GridViewColumn Header="التكلفة (ر.س)"
                                                        DisplayMemberBinding="{Binding CostPrice, StringFormat='{}{0:N2}'}"
                                                        Width="105" />
                                        <GridViewColumn Header="المخزون"
                                                        DisplayMemberBinding="{Binding Stock}"
                                                        Width="80" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

</Window>
