<Window x:Class="MizanPro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان برو — نظام المحاسبة السعودي"
        Width="1280" Height="800" MinWidth="1024" MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}"
        UseLayoutRounding="True">

    <!-- حواف تغيير الحجم بدون إطار النظام (CaptionHeight=0: السحب يُدار يدوياً) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ الصف 0: الشريط العلوي ═══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurfaceBrush}"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- (يمين الشاشة في RTL) زر القائمة الجانبية + الاسم -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,6,0">
                    <Button Content="☰" Style="{StaticResource TopIconButtonStyle}"
                            FontSize="18" ToolTip="إظهار / إخفاء القائمة الجانبية"
                            Click="ToggleSidebar_Click" />
                    <TextBlock Text="ميزان Pro" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="8,0,6,0" />
                </StackPanel>

                <!-- مربع البحث في الوسط -->
                <Border Grid.Column="1" Background="{StaticResource DarkCardBrush}"
                        CornerRadius="6" Width="320" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                 Tag="ابحث..." Width="270" Margin="8,0,0,0"
                                 KeyDown="SearchBox_KeyDown" />
                    </StackPanel>
                </Border>

                <!-- (يسار الشاشة في RTL) الإشعارات + المستخدم + أزرار النافذة -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- جرس الإشعارات مع شارة عدد الفواتير المتأخرة -->
                    <Grid>
                        <Button Content="🔔" Style="{StaticResource TopIconButtonStyle}"
                                FontSize="15" ToolTip="الفواتير المتأخرة"
                                Click="Bell_Click" />
                        <Border x:Name="BellBadge" Background="{StaticResource DangerBrush}"
                                CornerRadius="8" MinWidth="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,2,4,0" Padding="4,1" Visibility="Collapsed">
                            <TextBlock x:Name="BellBadgeText" Text="0" FontSize="9"
                                       Foreground="White" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Background="#2D3748" Width="1" Height="20" Margin="10,0" />

                    <!-- صورة رمزية: أول حرفين من اسم المستخدم -->
                    <Button x:Name="AvatarButton" Click="Avatar_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" ToolTip="الإعدادات">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource GoldBrush}">
                            <TextBlock x:Name="AvatarText" Text="—" FontSize="12" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Button>

                    <Separator Width="1" Background="#2D3748" Margin="8,0" />

                    <Button Content="—" Style="{StaticResource WindowControlButtonStyle}"
                            Click="Minimize_Click" />
                    <Button Content="□" Style="{StaticResource WindowControlButtonStyle}"
                            Click="Maximize_Click" />
                    <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ الصف 1: القائمة الجانبية + المحتوى ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- القائمة الجانبية (عرض متحرك 240 ↔ 64) -->
            <Border x:Name="SidebarHost" Grid.Column="0" Width="240"
                    Background="{StaticResource DarkBgBrush}"
                    HorizontalAlignment="Right">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- عناصر التنقل -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,0">
                        <StackPanel x:Name="NavPanel">
                            <Button x:Name="NavDashboard" Style="{StaticResource NavItemStyle}"
                                    Tag="dashboard" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabelDashboard" Text="لوحة التحكم" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavInvoices" Style="{StaticResource NavItemStyle}"
                                    Tag="invoices" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧾" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabelInvoices" Text="الفواتير" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavCustomers" Style="{StaticResource NavItemStyle}"
                                    Tag="customers" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabelCustomers" Text="العملاء" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavProducts" Style="{StaticResource NavItemStyle}"
                                    Tag="products" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabelProducts" Text="المنتجات" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavReports" Style="{StaticResource NavItemStyle}"
                                    Tag="reports" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabelReports" Text="التقارير" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSettings" Style="{StaticResource NavItemStyle}"
                                    Tag="settings" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NavLabelSettings" Text="الإعدادات" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- أسفل القائمة: حالة الترخيص + المستخدم + الخروج -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Border Background="#1B2836" Height="1" Margin="8,8,8,10" />

                        <Border Style="{StaticResource DarkCardBorderStyle}" Margin="8,0">
                            <TextBlock x:Name="LicenseText" Text="⏰ تجربة" FontSize="11"
                                       FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <TextBlock x:Name="SidebarUserName" Text="—" FontSize="13" Foreground="White"
                                   Margin="20,12,12,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SidebarUserRole" Text="—" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" Margin="20,3,12,0" />

                        <Button HorizontalAlignment="Right" Margin="8,10,8,0"
                                Style="{StaticResource DangerGhostButtonStyle}" Click="Logout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏻" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="LogoutLabel" Text="تسجيل خروج" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منطقة عرض الصفحات -->
            <Border Grid.Column="1" Background="{StaticResource LightBgBrush}">
                <ContentControl x:Name="ContentHost" />
            </Border>
        </Grid>

        <!-- ═══════════════ الصف 2: شريط الحالة ═══════════════ -->
        <Border Grid.Row="2" Background="#1E2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0">
                    <TextBlock Text="●" FontSize="11" Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="متصل" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="StatusUserName" Grid.Column="1" Text="—"
                           FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusDate" Grid.Column="2" Text=""
                           FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                           Margin="0,0,14,0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>

</Window>
