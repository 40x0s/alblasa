<Window x:Class="MizanPro.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ميزان"
        Width="680" Height="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}"
        UseLayoutRounding="True">

    <!-- شاشة البداية: تهيئة قاعدة البيانات والتحقق من الترخيص عبر BackgroundWorker -->
    <Border CornerRadius="16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0E1A" Offset="0" />
                <GradientStop Color="#1B2B3B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="40"
                        Background="#1E3A5F" Opacity="0.9"
                        HorizontalAlignment="Center">
                    <TextBlock Text="⚖" FontSize="40" Foreground="{StaticResource GoldBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="ميزان" FontSize="34" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />

                <TextBlock Text="برو للمحاسبة وإدارة الأعمال" FontSize="13"
                           Foreground="{StaticResource TextFaintBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />

                <ProgressBar x:Name="Progress" Width="300" Height="3"
                             Style="{StaticResource SlimProgressBarStyle}"
                             Background="#233447" Margin="0,28,0,0" />

                <TextBlock x:Name="StatusText" Text="جاري التهيئة..." FontSize="11"
                           Foreground="{StaticResource TextLightBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <TextBlock Text="v3.0.0 · © 2025 ميزان" FontSize="9" Foreground="#2D4A62"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="20,0,20,14" />
        </Grid>
    </Border>

</Window>
