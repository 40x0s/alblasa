<Window x:Class="MizanPro.Windows.NewInvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة جديدة"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LightBgBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource MainFont}"
        UseLayoutRounding="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel>

            <TextBlock Text="فاتورة جديدة" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="فاتورة مبيعات بضريبة القيمة المضافة 15%" Style="{StaticResource PageSubtitleStyle}"
                       Margin="0,6,0,16" />

            <!-- ═══ بيانات العميل والتواريخ ═══ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="العميل" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="CustomerCombo" Style="{StaticResource ModernComboBoxStyle}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="تاريخ الإصدار" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="IssueDateBox" Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True" TextAlignment="Center"
                                 Foreground="{StaticResource TextLightBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="تاريخ الاستحقاق" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker x:Name="DueDatePicker" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ أصناف الفاتورة ═══ -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="الأصناف" Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="＋ إضافة صف" Style="{StaticResource LightGhostButtonStyle}"
                                    Click="AddRow_Click" />
                            <Button Content="🗑 حذف الصف المحدد" Style="{StaticResource DangerGhostButtonStyle}"
                                    Margin="8,0,0,0" Click="DeleteRow_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ItemsGrid" Margin="0,12,0,0" MinHeight="180"
                              IsReadOnly="False" RowHeight="44"
                              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=Window}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="المنتج" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="36"
                                                  ItemsSource="{Binding ProductsSource, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Product, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الكمية" Width="90"
                                                Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="السعر (ر.س)" Width="110"
                                                Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="الضريبة 15%" Width="100" IsReadOnly="True"
                                                Binding="{Binding TaxAmount, StringFormat='{}{0:N2}'}"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="الإجمالي (ر.س)" Width="120" IsReadOnly="True"
                                                Binding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                ElementStyle="{StaticResource GridCellTextBold}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ═══ الملاحظات والملخص المالي ═══ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <!-- الملاحظات -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="NotesInput" Style="{StaticResource ModernTextBoxStyle}"
                                 Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                                 Tag="ملاحظات تظهر على الفاتورة (اختياري)" />
                    </StackPanel>

                    <!-- الملخص -->
                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,2">
                            <TextBlock Text="المجموع قبل الضريبة" Style="{StaticResource CaptionStyle}" />
                            <TextBlock x:Name="SubTotalText" Text="0.00" HorizontalAlignment="Left"
                                       Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Grid Margin="0,8">
                            <TextBlock Text="ضريبة القيمة المضافة 15%" Style="{StaticResource CaptionStyle}" />
                            <TextBlock x:Name="VatText" Text="0.00" HorizontalAlignment="Left"
                                       Style="{StaticResource CaptionStyle}" />
                        </Grid>
                        <Grid Margin="0,8">
                            <TextBlock Text="الخصم (ر.س)" Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="DiscountInput" Width="110" HorizontalAlignment="Left"
                                     Style="{StaticResource ModernTextBoxStyle}" Padding="10,8"
                                     TextChanged="DiscountInput_TextChanged" Text="0" />
                        </Grid>
                        <Border Background="{StaticResource LightBgBrush}" CornerRadius="8"
                                Margin="0,12,0,0" Padding="14,10">
                            <Grid>
                                <TextBlock Text="الإجمالي" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextDarkBrush}" />
                                <TextBlock x:Name="TotalText" Text="0.00 ر.س" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource GoldDarkBrush}"
                                           HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- رسالة الخطأ -->
            <Border x:Name="ErrorBorder" Background="#FEF2F2" BorderBrush="#FCA5A5"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Text="" FontSize="13"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- الأزرار -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,8">
                <Button Content="إصدار الفاتورة" Style="{StaticResource GoldButtonStyle}"
                        MinWidth="170" Click="Issue_Click" />
                <Button Content="حفظ مسودة" Style="{StaticResource GoldOutlineButtonStyle}"
                        MinWidth="150" Margin="12,0,0,0" Click="Draft_Click" />
                <Button Content="إلغاء" Style="{StaticResource GhostButtonStyle}"
                        MinWidth="100" Margin="12,0,0,0" Click="Cancel_Click" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</Window>
