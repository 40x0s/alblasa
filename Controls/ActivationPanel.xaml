<UserControl x:Class="MizanPro.Controls.ActivationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource MainFont}">

    <!-- لوحة تفعيل البرنامج — تُعرض داخل نافذة الدخول أو في نافذة منبثقة من الإعدادات -->
    <StackPanel>
        <TextBlock Text="تفعيل ميزان Pro" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextDarkBrush}" />

        <TextBlock Text="أدخل مفتاح الترخيص المكوّن من 20 حرفاً"
                   FontSize="13" Foreground="{StaticResource TextLightBrush}"
                   Margin="0,6,0,16" />

        <!-- حقل المفتاح: خط ثابت العرض، لاتيني، تنسيق تلقائي XXXXX-XXXXX-XXXXX-XXXXX -->
        <TextBox x:Name="KeyBox"
                 Style="{StaticResource ModernTextBoxStyle}"
                 FlowDirection="LeftToRight"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="18"
                 TextAlignment="Center"
                 CharacterCasing="Upper"
                 MaxLength="24"
                 Tag="XXXXX-XXXXX-XXXXX-XXXXX"
                 TextChanged="KeyBox_TextChanged" />

        <!-- رسالة خطأ / نجاح -->
        <Border x:Name="MessageBorder" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="MessageText" Text="" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <Button x:Name="ActivateButton"
                Content="تحقق وتفعيل" Height="44"
                Style="{StaticResource GoldButtonStyle}"
                Margin="0,16,0,0"
                Click="Activate_Click" />
    </StackPanel>

</UserControl>
