<UserControl x:Class="MizanPro.Controls.ActivationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <!-- لوحة تفعيل البرنامج — تُعرض داخل AuthWindow عند الحاجة للتفعيل -->
    <StackPanel>
        <TextBlock Text="تفعيل البرنامج"
                   Style="{StaticResource SectionTitleStyle}" FontSize="22" />

        <TextBlock Text="أدخل مفتاح التفعيل المرتبط بهذا الجهاز لاستخدام البرنامج دون قيود زمنية."
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TextBlock Text="مفتاح التفعيل"
                   Style="{StaticResource FieldLabelStyle}" Margin="2,22,0,0" />

        <!-- حقل المفتاح: لاتيني من اليسار لليمين بخط ثابت العرض -->
        <TextBox x:Name="KeyBox"
                 Style="{StaticResource ModernTextBoxStyle}"
                 FlowDirection="LeftToRight"
                 FontFamily="Consolas"
                 FontSize="15"
                 TextAlignment="Center"
                 CharacterCasing="Upper"
                 MaxLength="23" />

        <TextBlock Text="تنسيق المفتاح: XXXXX-XXXXX-XXXXX-XXXXX (20 حرفاً/رقماً)"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="11.5" Margin="2,6,0,0" />

        <TextBlock x:Name="MessageText"
                   Text="" FontSize="12.5" TextWrapping="Wrap"
                   Margin="2,12,0,0" />

        <Button x:Name="ActivateButton"
                Content="تفعيل"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0,16,0,0"
                Click="Activate_Click" />
    </StackPanel>

</UserControl>
