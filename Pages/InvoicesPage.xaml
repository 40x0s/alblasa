<UserControl x:Class="MizanPro.Pages.InvoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource LightBgBrush}"
             FontFamily="{StaticResource MainFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel>

            <!-- الترويسة + زر فاتورة جديدة -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="الفواتير" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="جميع الفواتير المسجلة في النظام"
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="فاتورة جديدة  +"
                        Style="{StaticResource GoldButtonStyle}" FontSize="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Click="NewInvoice_Click" />
            </Grid>

            <!-- شريط الفلاتر -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchInput" Style="{StaticResource ModernTextBoxStyle}"
                             Tag="ابحث برقم الفاتورة أو العميل" Width="260"
                             TextChanged="SearchInput_TextChanged" />

                    <ComboBox x:Name="StatusCombo" Style="{StaticResource ModernComboBoxStyle}"
                              Width="130" Margin="12,0,0,0"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="كل الحالات" IsSelected="True" />
                        <ComboBoxItem Content="مسودة" />
                        <ComboBoxItem Content="صادرة" />
                        <ComboBoxItem Content="مدفوعة" />
                        <ComboBoxItem Content="ملغاة" />
                    </ComboBox>

                    <DatePicker x:Name="FromPicker" Width="150" Margin="12,0,0,0"
                                SelectedDateChanged="Filter_Changed" />
                    <DatePicker x:Name="ToPicker" Width="150" Margin="12,0,0,0"
                                SelectedDateChanged="Filter_Changed" />

                    <Button Content="مسح الفلاتر" Style="{StaticResource LightGhostButtonStyle}"
                            Margin="12,0,0,0" Click="ClearFilters_Click" />
                </StackPanel>
            </Border>

            <!-- شريط التحميل -->
            <ProgressBar x:Name="Loader" Style="{StaticResource SlimProgressBarStyle}"
                         IsIndeterminate="True" Margin="0,0,0,12" Visibility="Collapsed" />

            <!-- جدول الفواتير -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                <StackPanel>
                    <DataGrid x:Name="InvoicesGrid" MinHeight="240">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="☐" IsReadOnly="False" />
                            <DataGridTextColumn Header="رقم الفاتورة"
                                                Binding="{Binding InvoiceNumber}"
                                                ElementStyle="{StaticResource GridCellMono}" />
                            <DataGridTextColumn Header="العميل"
                                                Binding="{Binding Customer.Name}"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="النوع"
                                                Binding="{Binding Type, Converter={StaticResource InvoiceTypeText}}"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="التاريخ"
                                                Binding="{Binding IssueDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="المبلغ (ر.س)"
                                                Binding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                ElementStyle="{StaticResource GridCellTextBold}" />
                            <DataGridTemplateColumn Header="الحالة">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" CornerRadius="12" Padding="10,3"
                                                HorizontalAlignment="Right" Background="#F3F4F6">
                                            <TextBlock x:Name="BadgeText" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="#6B7A8D"
                                                       Text="{Binding Status, Converter={StaticResource InvoiceStatusText}}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Issued">
                                                <Setter TargetName="Badge" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#1D4ED8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                <Setter TargetName="Badge" Property="Background" Value="#F0FDF4" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#15803D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                <Setter TargetName="Badge" Property="Background" Value="#FEF2F2" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="إجراءات">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁" Style="{StaticResource RowIconButtonStyle}"
                                                    ToolTip="عرض التفاصيل" Click="ViewInvoice_Click" />
                                            <Button Content="✏️" Style="{StaticResource RowIconButtonStyle}"
                                                    ToolTip="تعليم كمدفوعة" Click="MarkPaid_Click" />
                                            <Button Content="🖨️" Style="{StaticResource RowIconButtonStyle}"
                                                    ToolTip="طباعة" Click="PrintInvoice_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="EmptyText" Text="لا توجد بيانات بعد" HorizontalAlignment="Center"
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,20" Visibility="Collapsed" />

                    <!-- شريط التنقل بين الصفحات -->
                    <Grid Margin="8,12,8,4">
                        <TextBlock x:Name="PagingText" Text="عرض 0-0 من 0"
                                   Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="FirstPageButton" Content="« الأولى" MinWidth="70"
                                    Style="{StaticResource LightGhostButtonStyle}"
                                    Click="FirstPage_Click" />
                            <Button x:Name="PrevPageButton" Content="‹ السابقة" MinWidth="70"
                                    Style="{StaticResource LightGhostButtonStyle}" Margin="6,0,0,0"
                                    Click="PrevPage_Click" />
                            <Button x:Name="NextPageButton" Content="التالية ›" MinWidth="70"
                                    Style="{StaticResource LightGhostButtonStyle}" Margin="6,0,0,0"
                                    Click="NextPage_Click" />
                            <Button x:Name="LastPageButton" Content="الأخيرة »" MinWidth="70"
                                    Style="{StaticResource LightGhostButtonStyle}" Margin="6,0,0,0"
                                    Click="LastPage_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
