<UserControl x:Class="MizanPro.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource LightBgBrush}"
             FontFamily="{StaticResource MainFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel>

            <!-- الترويسة + اختيار الشهر والسنة -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="التقارير" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="الملخص المالي الشهري" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBox x:Name="MonthCombo" Style="{StaticResource ModernComboBoxStyle}" Width="130"
                              SelectionChanged="Period_Changed" />
                    <ComboBox x:Name="YearCombo" Style="{StaticResource ModernComboBoxStyle}" Width="110"
                              Margin="12,0,0,0" SelectionChanged="Period_Changed" />
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="Loader" Style="{StaticResource SlimProgressBarStyle}"
                         IsIndeterminate="True" Margin="0,16" Visibility="Collapsed" />

            <!-- بطاقات الملخص -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="20,20">
                    <StackPanel>
                        <TextBlock Text="عدد الفواتير" FontSize="12" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="CountValue" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,12" Padding="20,20">
                    <StackPanel>
                        <TextBlock Text="المجموع قبل الضريبة" FontSize="12" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="SubTotalValue" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="20,20">
                    <StackPanel>
                        <TextBlock Text="ضريبة القيمة المضافة 15%" FontSize="12" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="VatValue" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="20,20">
                    <StackPanel>
                        <TextBlock Text="إجمالي المبيعات" FontSize="12" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="TotalValue" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0" Padding="20,20">
                    <StackPanel>
                        <TextBlock Text="المسدد" FontSize="12" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="PaidValue" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0" Padding="20,20">
                    <StackPanel>
                        <TextBlock Text="المتبقي" FontSize="12" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock x:Name="OutstandingValue" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- توزيع الحالات -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="توزيع الفواتير حسب الحالة" Style="{StaticResource CardTitleStyle}" />
                    <ItemsControl x:Name="StatusList" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   Foreground="{StaticResource TextMidBrush}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDarkBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock x:Name="EmptyText" Text="لا توجد فواتير في هذه الفترة" HorizontalAlignment="Center"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,24" Visibility="Collapsed" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
