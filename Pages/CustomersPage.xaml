<UserControl x:Class="MizanPro.Pages.CustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource LightBgBrush}"
             FontFamily="{StaticResource MainFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel>

            <!-- الترويسة + زر عميل جديد + مبدّل العرض -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="العملاء" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="قائمة العملاء وبياناتهم"
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- مبدّل العرض: بطاقات / قائمة -->
                    <Border Background="#EDF0F4" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="CardsToggle" Content="▦ بطاقات" IsChecked="True"
                                          Style="{StaticResource SegToggleStyle}" Checked="CardsToggle_Checked" />
                            <ToggleButton x:Name="ListToggle" Content="☰ قائمة"
                                          Style="{StaticResource SegToggleStyle}" Margin="4,0,0,0"
                                          Checked="ListToggle_Checked" />
                        </StackPanel>
                    </Border>

                    <Button Content="عميل جديد  +" Style="{StaticResource GoldButtonStyle}" FontSize="14"
                            Margin="16,0,0,0" Click="NewCustomer_Click" />
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="Loader" Style="{StaticResource SlimProgressBarStyle}"
                         IsIndeterminate="True" Margin="0,16" Visibility="Collapsed" />

            <!-- ═══ عرض البطاقات ═══ -->
            <ItemsControl x:Name="CardsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Width="330" Margin="0,0,14,14"
                                Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="56" Height="56" CornerRadius="28"
                                            Background="{Binding Brush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Width="220">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Phone}" FontSize="12.5"
                                                   Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Email}" FontSize="11.5"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="{StaticResource LightBorderBrush}" Height="1"
                                        Margin="0,14" />

                                <TextBlock Text="{Binding StatsText}" FontSize="12"
                                           Foreground="{StaticResource TextMidBrush}" />

                                <!-- شريط الديون -->
                                <TextBlock Text="{Binding BalanceText}" FontSize="12" Margin="0,10,0,4"
                                           Foreground="{Binding BalanceBrush}" />
                                <Grid Width="220" HorizontalAlignment="Right">
                                    <Border Background="{StaticResource LightBgBrush}" Height="6"
                                            CornerRadius="3" />
                                    <Border Background="{StaticResource DangerBrush}" Height="6"
                                            CornerRadius="3" HorizontalAlignment="Right"
                                            Width="{Binding DebtWidth}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyCardsText" Text="لا توجد بيانات بعد" HorizontalAlignment="Center"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,24" Visibility="Collapsed" />

            <!-- ═══ عرض القائمة ═══ -->
            <Border x:Name="ListHost" Style="{StaticResource CardBorderStyle}" Padding="8" Visibility="Collapsed">
                <DataGrid x:Name="ListGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource GridCellTextBold}" />
                        <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}"
                                            ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="المدينة" Binding="{Binding City}"
                                            ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="الرقم الضريبي" Binding="{Binding TaxNumber}"
                                            ElementStyle="{StaticResource GridCellMono}" />
                        <DataGridTextColumn Header="الرصيد (ر.س)"
                                            Binding="{Binding Balance, StringFormat='{}{0:N2}'}"
                                            ElementStyle="{StaticResource GridCellTextBold}" />
                        <DataGridTemplateColumn Header="الحالة">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Badge" CornerRadius="12" Padding="10,3"
                                            HorizontalAlignment="Right" Background="#F0FDF4">
                                        <TextBlock x:Name="BadgeText" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="#15803D"
                                                   Text="{Binding IsActive, Converter={StaticResource BooleanStateText}}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter TargetName="Badge" Property="Background" Value="#F3F4F6" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#6B7A8D" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="EmptyListText" Text="لا توجد بيانات بعد" HorizontalAlignment="Center"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,24" Visibility="Collapsed" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
