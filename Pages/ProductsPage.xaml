<UserControl x:Class="MizanPro.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource LightBgBrush}"
             FontFamily="{StaticResource MainFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel>

            <!-- الترويسة -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="المنتجات" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText" Text="قائمة المنتجات وأسعارها ومخزونها"
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="منتج جديد  +" Style="{StaticResource GoldButtonStyle}" FontSize="14"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Click="NewProduct_Click" />
            </Grid>

            <!-- الفلاتر -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchInput" Style="{StaticResource ModernTextBoxStyle}"
                             Tag="ابحث بالاسم أو SKU" Width="240"
                             TextChanged="SearchInput_TextChanged" />

                    <ComboBox x:Name="CategoryCombo" Style="{StaticResource ModernComboBoxStyle}"
                              Width="150" Margin="12,0,0,0"
                              SelectionChanged="Filter_Changed" />

                    <ComboBox x:Name="StockCombo" Style="{StaticResource ModernComboBoxStyle}"
                              Width="150" Margin="12,0,0,0"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="كل حالات المخزون" IsSelected="True" />
                        <ComboBoxItem Content="متوفر" />
                        <ComboBoxItem Content="منخفض" />
                        <ComboBoxItem Content="نفد" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="Loader" Style="{StaticResource SlimProgressBarStyle}"
                         IsIndeterminate="True" Margin="0,0,0,12" Visibility="Collapsed" />

            <!-- بطاقات المنتجات -->
            <ItemsControl x:Name="CardsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Width="310" Margin="0,0,14,14"
                                Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="10"
                                            Background="{StaticResource LightBgBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Emoji}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="210">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sku}" FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,3,0,0"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Background="{StaticResource LightBorderBrush}" Height="1"
                                        Margin="0,14" />

                                <Grid>
                                    <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource GoldDarkBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StockText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding StockBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="لا توجد بيانات بعد" HorizontalAlignment="Center"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,24" Visibility="Collapsed" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
