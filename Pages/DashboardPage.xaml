<UserControl x:Class="MizanPro.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource LightBgBrush}"
             FontFamily="{StaticResource MainFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel>

            <!-- شريط التحميل -->
            <ProgressBar x:Name="Loader" Style="{StaticResource SlimProgressBarStyle}"
                         IsIndeterminate="True" Margin="0,0,0,16" Visibility="Collapsed" />

            <!-- الترويسة -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="لوحة التحكم" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="HeaderDate" Text="" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <!-- بطاقات المؤشرات -->
            <UniformGrid Columns="4" Margin="0,20,0,0">

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="20,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الإيرادات" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock x:Name="KpiRevenueValue" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                            <TextBlock x:Name="KpiRevenueChange" Text="—" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8"
                                Background="#EFF6FF" VerticalAlignment="Center">
                            <TextBlock Text="🧾" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,12" Padding="20,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="فواتير معلقة" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock x:Name="KpiPendingValue" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="قيد التحصيل" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8"
                                Background="#FFF7ED" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,12" Padding="20,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="عملاء جدد" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock x:Name="KpiNewCustomersValue" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="خلال هذا الشهر" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8"
                                Background="#F0FDF4" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="20,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="المصروفات" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock x:Name="KpiExpensesValue" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}" Margin="0,6,0,0" />
                            <TextBlock x:Name="KpiExpensesChange" Text="مشتريات هذا الشهر" FontSize="12"
                                       Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8"
                                Background="#FEF2F2" VerticalAlignment="Center">
                            <TextBlock Text="📤" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- آخر الفواتير + أبرز العملاء -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*" />
                    <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>

                <!-- آخر الفواتير -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="آخر الفواتير" Style="{StaticResource CardTitleStyle}" />
                        <DataGrid x:Name="RecentInvoicesGrid" Margin="0,14,0,0" MinHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة"
                                                    Binding="{Binding InvoiceNumber}"
                                                    ElementStyle="{StaticResource GridCellMono}" />
                                <DataGridTextColumn Header="العميل"
                                                    Binding="{Binding Customer.Name}"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="المبلغ (ر.س)"
                                                    Binding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                    ElementStyle="{StaticResource GridCellTextBold}" />
                                <DataGridTemplateColumn Header="الحالة">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Badge" CornerRadius="12" Padding="10,3"
                                                    HorizontalAlignment="Right" Background="#F3F4F6">
                                                <TextBlock x:Name="BadgeText" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="#6B7A8D"
                                                           Text="{Binding Status, Converter={StaticResource InvoiceStatusText}}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Issued">
                                                    <Setter TargetName="Badge" Property="Background" Value="#EFF6FF" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#1D4ED8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                    <Setter TargetName="Badge" Property="Background" Value="#F0FDF4" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#15803D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter TargetName="Badge" Property="Background" Value="#FEF2F2" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#DC2626" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="التاريخ"
                                                    Binding="{Binding IssueDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                                    ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyInvoicesText" Text="لا توجد بيانات بعد"
                                   Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center"
                                   Margin="0,16" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- أبرز العملاء -->
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="أبرز العملاء" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="الأعلى قيمة فواتير" Style="{StaticResource PageSubtitleStyle}"
                                   Margin="0,4,0,12" />
                        <ItemsControl x:Name="TopCustomersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{Binding Brush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" Width="140">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextDarkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CountText}" FontSize="11"
                                                       Foreground="{StaticResource TextLightBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AmountText}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyCustomersText" Text="لا توجد بيانات بعد"
                                   Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center"
                                   Margin="0,16" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
